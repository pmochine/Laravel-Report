{
    "name": "pmochine/laravel-report",
    "description": "Reportable polymorphic Eloquent models for Laravel 11, 12 and 13",
    "keywords": ["laravel", "report", "Laravel-reportable", "Laravel Reportable", "Laravel-report", "Laravel Report", "feedback"],
    "license": "MIT",
    "authors": [{
        "name": "Brian Faust",
        "email": "hello@brianfaust.me",
        "homepage": "https://brianfaust.me"
        },
        {
          "name": "Philipp Mochine",
          "email": "mail@philippmochine.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pmochine\\Report\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pmochine\\Tests\\Report\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        },
        "laravel": {
            "providers": [
                "Pmochine\\Report\\ReportServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
